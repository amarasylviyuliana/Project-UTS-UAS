{
  "name": "BUMDES - Send Telegram Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bumdes-notify",
        "responseMode": "onReceived",
        "responseData": "{\"message\":\"ok\"}"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 250]
    },
    {
      "parameters": {
        "functionCode": "const body = $json;\nconst payload = body;\nconst groupChat = payload.group_chat_id || null;\nconst buyerChat = payload.pembeli_telegram_chat_id || payload.buyer_chat_id || null;\nconst sellerChat = payload.seller_telegram_chat_id || null;\n\nconst orderNum = payload.order_number || payload.order_id || '-';\nconst item = payload.item || '-';\nconst total = payload.total ? Number(payload.total).toLocaleString('id-ID') : '-';\nconst status = payload.status || payload.event || '-';\nconst buyerName = payload.pembeli_nama || '-';\nconst storeName = payload.bumdes_nama || '-';\n\nconst groupText = `📦 *Pesanan Baru BUMDes Jabar*\\n\\n` +\n  `📋 Order: *${orderNum}*\\n` +\n  `👤 Pembeli: ${buyerName}\\n` +\n  `🏪 Toko: ${storeName}\\n` +\n  `🛒 Produk: ${item}\\n` +\n  `💰 Total: Rp ${total}\\n` +\n  `📊 Status: ${status}`;\n\nconst buyerText = `Halo ${buyerName}! 👋\\n\\n` +\n  `Pesanan kamu telah diterima:\\n` +\n  `📋 Order: *${orderNum}*\\n` +\n  `🛒 Produk: ${item}\\n` +\n  `💰 Total: Rp ${total}\\n` +\n  `📊 Status: ${status}\\n\\n` +\n  `Terima kasih sudah berbelanja di BUMDes Jabar! 🙏`;\n\nreturn [{\n  json: {\n    payload,\n    groupChat,\n    buyerChat,\n    groupText,\n    buyerText,\n    orderNum\n  }\n}];"
      },
      "name": "Prepare Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 250]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot8993863404:AAHDvEroqtOpMX15DiI0G7M5ZLEuXl_gcSc/sendMessage",
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "chat_id",
              "value": "={{ $json[\"groupChat\"] }}"
            },
            {
              "name": "text",
              "value": "={{ $json[\"groupText\"] }}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        }
      },
      "name": "Send To Group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [700, 350]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json[\"buyerChat\"] }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Has Buyer Chat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 150]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot8993863404:AAHDvEroqtOpMX15DiI0G7M5ZLEuXl_gcSc/sendMessage",
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "chat_id",
              "value": "={{ $json[\"buyerChat\"] }}"
            },
            {
              "name": "text",
              "value": "={{ $json[\"buyerText\"] }}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        }
      },
      "name": "Send To Buyer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [950, 100]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Prepare Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Message": {
      "main": [
        [
          {
            "node": "Send To Group",
            "type": "main",
            "index": 0
          },
          {
            "node": "Has Buyer Chat?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Buyer Chat?": {
      "main": [
        [
          {
            "node": "Send To Buyer",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  }
}
