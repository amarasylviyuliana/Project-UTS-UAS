APP_NAME=BUMDes
APP_ENV=production
APP_KEY=base64:bdLV4NIoJhp06IRsEs+5CHANqjhF7rviA3fh9swzkUA=
APP_DEBUG=false
APP_URL=https://bumdes-api-production.up.railway.app
FRONTEND_URL=https://project-uts-4751pxfva-bumdesjabar.vercel.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# FIX: Ganti ke Railway MySQL — bukan localhost 'db'
DB_CONNECTION=mysql
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_DATABASE=${{MYSQLDATABASE}}
DB_USERNAME=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}

BROADCAST_DRIVER=log
CACHE_DRIVER=file

# FIX KRITIS: Ganti local -> public agar foto bisa diakses via URL
FILESYSTEM_DISK=public

QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=Mid-client-5LTBgOeDFtKhl8OZ
MIDTRANS_IS_PRODUCTION=false

# Dipakai fitur pencarian produk berbasis AI (POST /api/products/ai-search)
# untuk memahami query bahasa natural (mis. "makanan pedas Garut") menjadi
# kriteria terstruktur (keywords, tags/atribut, kategori, daerah, harga).
# Ambil API key gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Algolia = mesin pencarian & rangking hasil (typo-tolerant, super cepat,
# mendukung facet seperti tags/kategori/daerah). Ambil di
# https://dashboard.algolia.com/account/api-keys
# - ALGOLIA_ADMIN_API_KEY: RAHASIA, jangan pernah dipakai di frontend/mobile.
# - ALGOLIA_SEARCH_API_KEY: read-only, aman kalau nanti dipakai langsung di client.
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_api_key
ALGOLIA_SEARCH_API_KEY=your_algolia_search_api_key
ALGOLIA_PRODUCTS_INDEX=bumdes_products